---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Hr from "@/components/Hr.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { SITE } from "@/config";
import { getProjects } from "@/utils/getProjects";
import type { ImageMetadata } from "astro";

const projects = getProjects();

// Load all project logos once
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{png,jpg,jpeg,svg}",
  { eager: true }
);

// Helper to get logo image for a project
const getLogoImage = (project: ReturnType<typeof getProjects>[number]) => {
  const logoPath = Object.keys(images).find(path =>
    path.startsWith(`/src/assets/projects/${project.id}.`)
  );
  return logoPath ? images[logoPath].default : null;
};

// Separate featured and non-featured projects
const featuredProjects = projects.filter(p => p.featured);
const otherProjects = projects.filter(p => !p.featured);

// Collect all unique tech for filtering and count occurrences
const techCounts = new Map<string, number>();

projects.forEach(project => {
  project.tech?.forEach(t => {
    techCounts.set(t, (techCounts.get(t) || 0) + 1);
  });
});

// Sort by count (descending), then alphabetically
const techList = Array.from(techCounts.entries())
  .sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1]; // Sort by count descending
    return a[0].localeCompare(b[0]); // Then alphabetically
  })
  .map(([tech]) => tech);
---

<Layout title={`Projects | ${SITE.title}`}>
  <Header activeNav="projects" />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-3xl pb-12">
    <section class="mb-12">
      <h1 class="text-2xl font-semibold sm:text-3xl">Projects</h1>
      <p class="mt-2 text-base italic opacity-90">
        A collection of open-source software and side projects I’ve created.
      </p>

      <!-- Filter Controls -->
      <div
        class="border-skin-line bg-skin-card-muted mt-6 flex flex-wrap items-center justify-center gap-2 rounded-lg border p-4"
      >
        <span class="text-sm font-semibold opacity-60">Filter:</span>
        {
          techList.map(tech => (
            <button
              type="button"
              data-filter-type="tech"
              data-filter-value={tech}
              class="filter-btn hover:border-skin-accent rounded-full border px-3 py-1 text-sm opacity-80 transition-all hover:opacity-100"
            >
              {tech}
            </button>
          ))
        }
      </div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="mb-16">
          <h2
            id="featured-heading"
            class="mb-8 text-xl font-semibold opacity-50"
          >
            Featured
          </h2>
          <div>
            {featuredProjects.map(project => (
              <ProjectCard
                project={project}
                logoImage={getLogoImage(project)}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      otherProjects.length > 0 && (
        <>
          {featuredProjects.length > 0 && <Hr id="section-divider" />}
          <section class="mt-16 mb-16">
            <h2
              id="other-heading"
              class="mb-8 text-xl font-semibold opacity-50"
            >
              Other Projects
            </h2>
            <div>
              {otherProjects.map(project => (
                <ProjectCard
                  project={project}
                  logoImage={getLogoImage(project)}
                />
              ))}
            </div>
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  interface FilterState {
    tech: Set<string>;
    tags: Set<string>;
    status: Set<string>;
  }

  function initFilters() {
    const filterState: FilterState = {
      tech: new Set(),
      tags: new Set(),
      status: new Set(),
    };

    const filterButtons =
      document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const clearButton =
      document.querySelector<HTMLButtonElement>("#clear-filters");
    const projectCards =
      document.querySelectorAll<HTMLElement>(".project-card");
    const featuredHeading =
      document.querySelector<HTMLElement>("#featured-heading");
    const otherHeading = document.querySelector<HTMLElement>("#other-heading");
    const sectionDivider =
      document.querySelector<HTMLElement>("#section-divider");

    function updateCardVisibility() {
      const hasActiveFilters =
        filterState.tech.size > 0 ||
        filterState.tags.size > 0 ||
        filterState.status.size > 0;

      // Hide/show section headings and divider based on filter state
      if (featuredHeading) {
        featuredHeading.style.display = hasActiveFilters ? "none" : "";
      }
      if (otherHeading) {
        otherHeading.style.display = hasActiveFilters ? "none" : "";
      }
      if (sectionDivider) {
        sectionDivider.style.display = hasActiveFilters ? "none" : "";
      }

      projectCards.forEach(card => {
        const cardTech = JSON.parse(card.dataset.tech || "[]") as string[];
        const cardTags = JSON.parse(card.dataset.tags || "[]") as string[];
        const cardStatus = card.dataset.status || "";

        // If no filters are active, show all
        if (!hasActiveFilters) {
          card.style.display = "";
          return;
        }

        // Check if card matches active filters
        const matchesTech =
          filterState.tech.size === 0 ||
          cardTech.some(t => filterState.tech.has(t));
        const matchesTags =
          filterState.tags.size === 0 ||
          cardTags.some(t => filterState.tags.has(t));
        const matchesStatus =
          filterState.status.size === 0 || filterState.status.has(cardStatus);

        // Show card only if it matches all active filter types
        if (matchesTech && matchesTags && matchesStatus) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    }

    function toggleFilter(
      type: keyof FilterState,
      value: string,
      button: HTMLButtonElement
    ) {
      const filterSet = filterState[type];

      // If clicking the same filter, deselect it
      if (filterSet.has(value)) {
        filterSet.delete(value);
        button.classList.remove("active-filter");
      } else {
        // Clear all filters and deactivate all buttons
        filterState.tech.clear();
        filterState.tags.clear();
        filterState.status.clear();
        filterButtons.forEach(btn => btn.classList.remove("active-filter"));

        // Activate only the clicked filter
        filterSet.add(value);
        button.classList.add("active-filter");
      }

      updateCardVisibility();
    }

    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        const type = button.dataset.filterType as keyof FilterState;
        const value = button.dataset.filterValue;
        if (type && value) {
          toggleFilter(type, value, button);
        }
      });
    });

    clearButton?.addEventListener("click", () => {
      filterState.tech.clear();
      filterState.tags.clear();
      filterState.status.clear();

      filterButtons.forEach(button => {
        button.classList.remove("active-filter");
      });

      updateCardVisibility();
    });
  }

  initFilters();

  // Re-initialize on Astro view transitions
  document.addEventListener("astro:page-load", initFilters);
</script>

<style>
  .filter-btn {
    border-color: var(--color-accent);
  }

  .active-filter {
    opacity: 1;
    font-weight: 600;
    background-color: var(--color-accent);
    color: var(--color-background);
    border-color: var(--color-accent);
  }
</style>
