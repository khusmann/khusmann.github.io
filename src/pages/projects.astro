---
import { readFileSync } from "fs";
import { load } from "js-yaml";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Hr from "@/components/Hr.astro";
import { SITE } from "@/config";
import type { Project } from "@/types/project";
import { parsePackage } from "@/types/project";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Load projects from YAML
const projectsYaml = readFileSync("src/data/projects.yaml", "utf8");
const projects = load(projectsYaml) as Project[];

// Separate featured and non-featured projects
const featuredProjects = projects.filter(p => p.featured);
const otherProjects = projects.filter(p => !p.featured);

// Collect all unique tech and tags for filtering
const allTech = new Set<string>();
const allTags = new Set<string>();

projects.forEach(project => {
  project.tech?.forEach(t => allTech.add(t));
  project.tags?.forEach(t => allTags.add(t));
});

const techList = Array.from(allTech).sort();
const tagList = Array.from(allTags).sort();

// Load project logos dynamically
const projectLogos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{png,jpg,jpeg,svg}', { eager: true });
---

<Layout title={`Projects | ${SITE.title}`}>
  <Header activeNav="projects" />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <section class="mb-12">
      <h1 class="text-2xl font-semibold sm:text-3xl">Projects</h1>
      <p class="mt-2 italic opacity-75">
        A collection of open-source software projects I've created and maintain.
      </p>

      <!-- Collapsible Filter Controls -->
      <details class="mt-6 group">
        <summary class="cursor-pointer text-sm opacity-60 hover:opacity-100 transition-opacity list-none flex items-center gap-2">
          <span class="inline-block transition-transform group-open:rotate-90">▸</span>
          Filter projects
        </summary>
        <div class="mt-4 space-y-3 text-sm opacity-75">
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs opacity-60">Tech:</span>
            {techList.map(tech => (
              <button
                type="button"
                data-filter-type="tech"
                data-filter-value={tech}
                class="filter-btn rounded-full px-2.5 py-0.5 text-xs transition-all opacity-60 hover:opacity-100"
              >
                {tech}
              </button>
            ))}
          </div>

          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs opacity-60">Tags:</span>
            {tagList.map(tag => (
              <button
                type="button"
                data-filter-type="tag"
                data-filter-value={tag}
                class="filter-btn rounded-full px-2.5 py-0.5 text-xs transition-all opacity-60 hover:opacity-100"
              >
                {tag}
              </button>
            ))}
          </div>

          <button
            type="button"
            id="clear-filters"
            class="text-xs opacity-60 hover:opacity-100 transition-opacity underline"
          >
            Clear filters
          </button>
        </div>
      </details>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="mb-16">
          <h2 class="mb-8 text-xl font-semibold opacity-50">Featured</h2>
          <div>
            {featuredProjects.map(project => {
              const packageInfo = project.package
                ? parsePackage(project.package)
                : null;

              // Get logo if it exists
              const logoPath = project.logo ? `/src/assets/projects/${project.id}/${project.logo}` : null;
              const logoImage = logoPath && projectLogos[logoPath] ? projectLogos[logoPath].default : null;

              return (
                <article
                  class="project-card group relative mb-12"
                  data-tech={JSON.stringify(project.tech || [])}
                  data-tags={JSON.stringify(project.tags || [])}
                  data-status={project.status}
                >
                  <div class="flex gap-4">
                    {logoImage && (
                      <div class="flex-shrink-0">
                        <Image
                          src={logoImage}
                          alt={`${project.name} logo`}
                          width={64}
                          height={64}
                          class="rounded"
                        />
                      </div>
                    )}
                    <div class="flex flex-col gap-3 flex-1">
                      <div class="flex items-baseline gap-3">
                      <h3 class="text-lg font-semibold">
                        {project.url ? (
                          <a
                            href={project.url}
                            class="transition-colors hover:text-accent"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {project.name}
                          </a>
                        ) : (
                          project.name
                        )}
                      </h3>
                      {project.status !== "active" && (
                        <span class="text-xs opacity-50">
                          ({project.status})
                        </span>
                      )}
                    </div>

                    <p class="text-sm opacity-75 leading-relaxed">
                      {project.description}
                    </p>

                    {project.tech && project.tech.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {project.tech.map(tech => (
                          <span class="text-xs opacity-60 font-mono">
                            {tech}
                          </span>
                        ))}
                      </div>
                    )}

                    <div class="flex flex-wrap gap-4 text-sm opacity-60">
                      {project.github && (
                        <a
                          href={project.github}
                          class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <IconGitHub width={14} height={14} />
                          <span>GitHub</span>
                        </a>
                      )}
                      {project.url && (
                        <a
                          href={project.url}
                          class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <IconArrowRight width={14} height={14} />
                          <span>Website</span>
                        </a>
                      )}
                      {packageInfo && (
                        <a
                          href={packageInfo.url}
                          class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100 uppercase"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {packageInfo.registry}
                        </a>
                      )}
                      {project.paper && (
                        <a
                          href={project.paper}
                          class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
                        >
                          Blog Post
                        </a>
                      )}
                    </div>
                  </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )
    }

    {
      otherProjects.length > 0 && (
        <>
          {featuredProjects.length > 0 && <Hr />}
          <section class="mb-16 mt-16">
            <h2 class="mb-8 text-xl font-semibold opacity-50">Other Projects</h2>
            <div>
              {otherProjects.map(project => {
                const packageInfo = project.package
                  ? parsePackage(project.package)
                  : null;
                return (
                  <article
                    class="project-card group relative mb-12"
                    data-tech={JSON.stringify(project.tech || [])}
                    data-tags={JSON.stringify(project.tags || [])}
                    data-status={project.status}
                  >
                    <div class="flex flex-col gap-3">
                      <div class="flex items-baseline gap-3">
                        <h3 class="text-lg font-semibold">
                          {project.url ? (
                            <a
                              href={project.url}
                              class="transition-colors hover:text-accent"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {project.name}
                            </a>
                          ) : (
                            project.name
                          )}
                        </h3>
                        {project.status !== "active" && (
                          <span class="text-xs opacity-50">
                            ({project.status})
                          </span>
                        )}
                      </div>

                      <p class="text-sm opacity-75 leading-relaxed">
                        {project.description}
                      </p>

                      {project.tech && project.tech.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {project.tech.map(tech => (
                            <span class="text-xs opacity-60 font-mono">
                              {tech}
                            </span>
                          ))}
                        </div>
                      )}

                      <div class="flex flex-wrap gap-4 text-sm opacity-60">
                        {project.github && (
                          <a
                            href={project.github}
                            class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <IconGitHub width={14} height={14} />
                            <span>GitHub</span>
                          </a>
                        )}
                        {project.url && (
                          <a
                            href={project.url}
                            class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <IconArrowRight width={14} height={14} />
                            <span>Website</span>
                          </a>
                        )}
                        {packageInfo && (
                          <a
                            href={packageInfo.url}
                            class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100 uppercase"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {packageInfo.registry}
                          </a>
                        )}
                        {project.paper && (
                          <a
                            href={project.paper}
                            class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
                          >
                            Blog Post
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  interface FilterState {
    tech: Set<string>;
    tags: Set<string>;
    status: Set<string>;
  }

  function initFilters() {
    const filterState: FilterState = {
      tech: new Set(),
      tags: new Set(),
      status: new Set(),
    };

    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const clearButton = document.querySelector<HTMLButtonElement>("#clear-filters");
    const projectCards = document.querySelectorAll<HTMLElement>(".project-card");

    function updateCardVisibility() {
      projectCards.forEach(card => {
        const cardTech = JSON.parse(card.dataset.tech || "[]") as string[];
        const cardTags = JSON.parse(card.dataset.tags || "[]") as string[];
        const cardStatus = card.dataset.status || "";

        // If no filters are active, show all
        if (
          filterState.tech.size === 0 &&
          filterState.tags.size === 0 &&
          filterState.status.size === 0
        ) {
          card.style.display = "";
          return;
        }

        // Check if card matches active filters
        const matchesTech =
          filterState.tech.size === 0 ||
          cardTech.some(t => filterState.tech.has(t));
        const matchesTags =
          filterState.tags.size === 0 ||
          cardTags.some(t => filterState.tags.has(t));
        const matchesStatus =
          filterState.status.size === 0 || filterState.status.has(cardStatus);

        // Show card only if it matches all active filter types
        if (matchesTech && matchesTags && matchesStatus) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    }

    function toggleFilter(type: keyof FilterState, value: string, button: HTMLButtonElement) {
      const filterSet = filterState[type];

      if (filterSet.has(value)) {
        filterSet.delete(value);
        button.classList.remove("active-filter");
      } else {
        filterSet.add(value);
        button.classList.add("active-filter");
      }

      updateCardVisibility();
    }

    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        const type = button.dataset.filterType as keyof FilterState;
        const value = button.dataset.filterValue;
        if (type && value) {
          toggleFilter(type, value, button);
        }
      });
    });

    clearButton?.addEventListener("click", () => {
      filterState.tech.clear();
      filterState.tags.clear();
      filterState.status.clear();

      filterButtons.forEach(button => {
        button.classList.remove("active-filter");
      });

      updateCardVisibility();
    });
  }

  initFilters();

  // Re-initialize on Astro view transitions
  document.addEventListener("astro:page-load", initFilters);
</script>

<style>
  .active-filter {
    opacity: 1 !important;
    font-weight: 600;
    text-decoration: underline;
  }
</style>
