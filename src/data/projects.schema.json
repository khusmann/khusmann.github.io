{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier (matches folder in src/assets/projects/)",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "description": "Display name of the project"
      },
      "description": {
        "type": "string",
        "description": "Short description of the project"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "Main project URL"
      },
      "github": {
        "type": "string",
        "format": "uri",
        "description": "GitHub repository URL"
      },
      "paper": {
        "type": "string",
        "pattern": "^(post:|doi:|pub:).+$",
        "description": "Blog post or paper in format 'post:2025/post-slug', 'doi:10.1016/j.example.2022.04.004', or 'pub:https://example.com/publication'"
      },
      "package": {
        "type": "string",
        "pattern": "^(npm|pypi|cran):.+$",
        "description": "Package registry in format 'registry:package-name' (e.g., 'npm:benlink', 'pypi:bydantic')"
      },
      "tech": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Technology stack used in the project"
      },
      "logo": {
        "type": "string",
        "default": "logo.svg",
        "description": "Logo filename (relative to src/assets/projects/{id}/)"
      },
      "created": {
        "type": "string",
        "format": "date",
        "description": "Project creation date (YYYY-MM-DD)"
      },
      "lastUpdated": {
        "type": "string",
        "format": "date",
        "description": "Last significant update date (YYYY-MM-DD)"
      },
      "featured": {
        "type": "boolean",
        "default": false,
        "description": "Whether to highlight this project"
      },
      "logoShadow": {
        "type": "boolean",
        "default": true,
        "description": "Whether to apply drop shadow to logo in light mode (disable for logos with non-transparent backgrounds)"
      }
    },
    "additionalProperties": false
  }
}
