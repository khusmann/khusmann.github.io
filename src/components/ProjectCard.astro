---
import type { Project } from "@/types/project";
import { parsePackage } from "@/types/project";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  project: Project;
  logoImage?: ImageMetadata | null;
}

const { project, logoImage } = Astro.props;

const packageInfo = project.package ? parsePackage(project.package) : null;
---

<article
  class="project-card group relative mb-12"
  data-tech={JSON.stringify(project.tech || [])}
  data-tags={JSON.stringify(project.tags || [])}
  data-status={project.status}
>
  <div class:list={["flex", logoImage ? "gap-4" : "flex-col gap-3"]}>
    {
      logoImage && (
        <div
          class="flex flex-shrink-0 items-center justify-center rounded bg-[#1a1a1a]"
          style="width: 80px; height: 80px;"
        >
          <Image
            src={logoImage}
            alt={`${project.name} logo`}
            width={64}
            height={64}
          />
        </div>
      )
    }
    <div class:list={["flex flex-col gap-3", logoImage ? "flex-1" : ""]}>

      <div class="flex items-baseline gap-3">
        <h3 class="text-xl font-semibold">
          {
            project.url ? (
              <a
                href={project.url}
                class="transition-colors hover:text-accent"
                target="_blank"
                rel="noopener noreferrer"
              >
                {project.name}
              </a>
            ) : (
              project.name
            )
          }
        </h3>
        {
          project.status !== "active" && (
            <span class="text-sm opacity-70">({project.status})</span>
          )
        }
      </div>

      <p class="text-base leading-relaxed opacity-90">
        {project.description}
      </p>

      {
        project.tech && project.tech.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {project.tech.map(tech => (
              <span class="font-mono text-sm opacity-75">{tech}</span>
            ))}
          </div>
        )
      }

      <div class="flex flex-wrap gap-4 text-base opacity-75">
        {
          project.github && (
            <a
              href={project.github}
              class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
              target="_blank"
              rel="noopener noreferrer"
            >
              <IconGitHub width={14} height={14} />
              <span>GitHub</span>
            </a>
          )
        }
        {
          project.url && (
            <a
              href={project.url}
              class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
              target="_blank"
              rel="noopener noreferrer"
            >
              <IconArrowRight width={14} height={14} />
              <span>Website</span>
            </a>
          )
        }
        {
          packageInfo && (
            <a
              href={packageInfo.url}
              class="inline-flex items-center gap-1.5 uppercase transition-opacity hover:opacity-100"
              target="_blank"
              rel="noopener noreferrer"
            >
              {packageInfo.registry}
            </a>
          )
        }
        {
          project.paper && (
            <a
              href={project.paper}
              class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-100"
            >
              Blog Post
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
